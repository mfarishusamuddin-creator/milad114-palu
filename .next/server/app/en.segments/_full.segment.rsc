d:["$","div",null,{"lang":"en","dir":"ltr","className":"site-shell flex min-h-screen flex-col bg-bg text-ink","children":[["$","a",null,{"href":"#konten","className":"skip-link","children":"Skip to content"}],["$","$L1e",null,{"dict":{"lang":"en","dir":"ltr","locale":"en-GB","meta":{"title":"Tanwir and the 114th Milad of Muhammadiyah — Together, Unite the Nation","description":"An interactive site for Tanwir and the 114th Milad of Muhammadiyah. Palu, 13–15 November 2026 CE | 4–6 Jumada al-Thani 1448 AH. A 114-year trail, the KHGT calendar, official news, a global map, and a quiz.","tagline":"Together, Unite the Nation"},"common":{"source":"Source","read":"Read","open":"Open","verified":"Verified","language":"Language","theme":"Theme","light":"Light","dark":"Dark","skipToContent":"Skip to content"},"nav":{"links":[{"href":"#jelajah","label":"Explore"},{"href":"#sejarah","label":"History"},{"href":"#layanan","label":"Services"},{"href":"#peta","label":"Map"}],"cta":"Explore the Trail","menuOpen":"Open menu","menuClose":"Close menu","language":"Language","themeLight":"Light mode","themeDark":"Dark mode","themeToggle":"Change theme"},"hero":{"edition":"Edition 114 · Palu 2026","eventLine":"Tanwir & the 114th Milad of Muhammadiyah","dateLine":"13–15 Nov 2026 · 4–6 Jumada al-Thani 1448 AH","eyebrow":"Tanwir & the 114th Milad of Muhammadiyah","titleLine1":"Together","titleLine2":"Unite the Nation","subtitle":"Tanwir and the 114th Milad of Muhammadiyah","intro":"For 114 years Muhammadiyah has grown from Kauman into a sheltering tree. Scroll through its trail, then open three directions: History, Services, and Map.","ctaPrimary":"Explore 114 Years","ctaSecondary":"Open Services","share":"Share","shareText":"Tanwir and the 114th Milad of Muhammadiyah — Together, Unite the Nation. Palu, 13–15 November 2026.","languageLine":"Read in","plate":{"identity":"Official identity","city":"Palu 2026","logoAlt":"Official logo of Tanwir and the 114th Milad of Muhammadiyah — Together, Unite the Nation, Palu 13–15 November 2026","caption":"Official logo · Tanwir & the 114th Milad","statLeft":"Root 1912","statCenter":"Canopy 2026","statRight":"114 years","stampTop":"114","stampBottom":"years"}},"countdown":{"beforeLabel":"Towards Tanwir & the Milad","duringLabel":"Tanwir & the Milad are underway","miladLabel":"Towards the 114th Milad","doneLabel":"The 114th Milad has passed","beforeNote":"Palu · 13–15 November 2026","duringNote":"Palu · 13–15 November 2026","miladNote":"18 November 2026","doneNote":"Thank you for exploring","wita":"WITA","days":"Days","hours":"Hours","minutes":"Minutes","seconds":"Seconds"},"gates":{"eyebrow":"Explore index","title":"One tree, three directions","description":"Choose the part you want to open. Each direction leads to one part of the same tree.","open":"Open","items":[{"number":"01","label":"Root","title":"114-Year Trail","description":"From Kauman in 1912 to Palu in 2026, told in six connected chapters.","href":"#sejarah","accent":"teal"},{"number":"02","label":"Trunk","title":"Muhammadiyah Services","description":"The KHGT calendar, official news, and the 114th Milad quiz in one service desk.","href":"#layanan","accent":"navy"},{"number":"03","label":"Canopy","title":"Global Reach","description":"A map of 29 Special Branch Leaderships of Muhammadiyah around the world.","href":"#peta","accent":"gold"}]},"tree":{"eyebrow":"One tree","titleLine1":"Growing from","titleLine2":"the same root.","description":"The root holds history. The trunk supports services. The canopy embraces a global reach. These three branches are three directions you can open.","legend":[{"number":"01","label":"Root","title":"114-Year Trail","description":"A long history from Kauman to Palu.","href":"#sejarah","accent":"teal"},{"number":"02","label":"Trunk","title":"Muhammadiyah Services","description":"Calendar, news, and quiz.","href":"#layanan","accent":"navy"},{"number":"03","label":"Canopy","title":"Global Reach","description":"29 PCIM across five regions.","href":"#peta","accent":"gold"}],"annotations":{"kanopi":"Canopy — Global Map","akar":"Root — History","batang":"Trunk — Services"},"stampTop":"114","stampBottom":"years","caption":"The tree illustration is generated with the space colonisation algorithm (Runions et al., 2007), reimplemented for this project."},"about":{"eyebrow":"About the Milad","title":"Growing from a single leaf","description":"The Tanwir and 114th Milad logo combines moringa leaves with the number 114. Moringa is not merely decorative: it grows in Palu, withstands weather, and offers benefits.","paragraphs":["The theme “Together, Unite the Nation” calls for togetherness directed toward justice, prosperity, welfare, morality, knowledge, and technology. It is linked to Quran 49:10 and 49:13.","As part of the programme, the committee planted 114 moringa trees in Palu. The number 114 meets root, trunk, and canopy: a long journey that remains grounded in benefit."],"facts":[{"label":"Host city","value":"Palu, Central Sulawesi"},{"label":"Dates","value":"13–15 November 2026"},{"label":"Hijri","value":"4–6 Jumada al-Thani 1448 AH"},{"label":"Symbol","value":"Moringa leaf & the number 114"}],"quote":"Moringa was chosen because it is strong, simple, and useful. It grows in Palu and becomes a symbol of resilience.","link":"Read the logo meaning"},"agenda":{"eyebrow":"Agenda","title":"Three markers in time","description":"The event dates, the historic date, and the next direction. Detailed schedules follow PP Muhammadiyah Circular No. 19/EDR/I.0/B/2026.","items":[{"date":"13–15 Nov 2026","title":"Tanwir and the 114th Milad","description":"Palu, Central Sulawesi. The main Tanwir and Milad programme, corresponding to 4–6 Jumada al-Thani 1448 AH.","tag":"Palu"},{"date":"18 Nov 2026","title":"114th Muhammadiyah Milad","description":"The historic Milad, commemorating the founding of Muhammadiyah on 18 November 1912 / 8 Dhu al-Hijjah 1330 AH.","tag":"Milad"},{"date":"2027","title":"49th Muktamar","description":"Medan, North Sumatra. Tanwir 2026 is a forum for evaluation and preparation ahead of the Muktamar.","tag":"2027"}],"button":"Open the Circular"},"history":{"eyebrow":"Root","title":"114-Year Trail","description":"From a living room in Kauman to a canopy that shelters Palu. Six chapters trace Muhammadiyah's root, trunk, and canopy, with official sources at every step.","mapEyebrow":"Journey map","source":"Source","verified":"Verified","ctaEyebrow":"Onward from the root","ctaTitle":"This tree has a trunk that supports services.","ctaDescription":"Open the KHGT calendar, official Muhammadiyah news, and the 114th Milad quiz in the Services section.","ctaButton":"Open Services","chapters":[{"id":"akar-kauman","year":"1868–1911","kicker":"Root","title":"Kauman and a living room that became a school","paragraphs":["Ahmad Dahlan was born in Kauman, Yogyakarta, in 1868 as Muhammad Darwis. He grew up around the mosque and pesantren, then travelled as far as Mecca in pursuit of knowledge.","On 1 December 1911, Madrasah Ibtidaiyah Diniyah Islamiyah was inaugurated after being started in the living room of his home. The school combined religious and general knowledge—an unusual idea for its time."],"facts":["KH Ahmad Dahlan's childhood name: Muhammad Darwis","The madrasa was inaugurated on 1 December 1911","It began in a 2.5 × 6 metre living room"],"sources":[{"label":"The Founding of Muhammadiyah","url":"https://muhammadiyah.or.id/sejarah-berdirinya-muhammadiyah/"},{"label":"A Brief History of Muhammadiyah","url":"https://muhammadiyah.or.id/sejarah-singkat-muhammadiyah/"}],"branch":"akar","verified":true},{"id":"tunas-1912","year":"1912","kicker":"Sprout","title":"The birth of Muhammadiyah","paragraphs":["On 18 November 1912 CE, or 8 Dhu al-Hijjah 1330 AH, Muhammadiyah was founded in Kauman, Yogyakarta. Nine founding members shaped an organisation to spread Islamic teaching and advance its members' knowledge. Ahmad Dahlan became its first chairman.","Two years later, on 22 August 1914, the Dutch East Indies government recognised Muhammadiyah as a legal entity through Besluit No. 81."],"facts":["18 November 1912 / 8 Dhu al-Hijjah 1330 AH","Founded in Kauman, Yogyakarta","Legal entity on 22 August 1914, Besluit No. 81"],"sources":[{"label":"A Brief History of Muhammadiyah","url":"https://muhammadiyah.or.id/sejarah-singkat-muhammadiyah/"},{"label":"The Founding of Muhammadiyah","url":"https://muhammadiyah.or.id/sejarah-berdirinya-muhammadiyah/"}],"branch":"akar","verified":true},{"id":"batang-kepemimpinan","year":"1912–1953","kicker":"Trunk","title":"From one kiai to a movement","paragraphs":["Early leadership passed from KH Ahmad Dahlan (1912–1923) to KH Ibrahim (1923–1931), KH Hisyam (1931–1936), KH Mas Mansur (1936–1942), and Ki Bagus Hadikusuma (1942–1953).","At the 1917 Budi Utomo congress held at Ahmad Dahlan's home, the vision expanded: not only Yogyakarta, but Java, Sumatra, Sulawesi, Kalimantan, and beyond."],"facts":["Five early leaders through 1953","The 1917 Budi Utomo congress at Ahmad Dahlan's home","A vision reaching across the archipelago"],"sources":[{"label":"A Brief History of Muhammadiyah","url":"https://muhammadiyah.or.id/sejarah-singkat-muhammadiyah/"}],"branch":"batang","verified":true},{"id":"cabang-amal-usaha","year":"1953–2026","kicker":"Branch","title":"Amal usaha that shelters","paragraphs":["From one madrasa, Muhammadiyah grew branches of amal usaha: education, health, social work, and empowerment. These are the concrete ways Muhammadiyah serves society.","Each branch is a way to educate, care, help, and empower. This page shows the direction of the movement and its official sources rather than figures that are not yet consistent."],"facts":["Education, health, social work, empowerment","Focus on benefit, not unverified numbers"],"sources":[{"label":"Muhammadiyah Profile","url":"https://muhammadiyah.or.id/profil/"}],"branch":"batang","verified":true},{"id":"kanopi-palu","year":"2026","kicker":"Canopy","title":"Palu, moringa, and resilience","paragraphs":["Palu, Central Sulawesi, hosts Tanwir and the 114th Milad. Universitas Muhammadiyah Palu and other amal usaha are part of the movement's life in the city.","As part of the programme, 114 moringa trees were planted in Palu. Moringa—strong, simple, and useful—becomes a metaphor for Muhammadiyah's 114-year journey."],"facts":["Host city: Palu, Central Sulawesi","114 moringa trees planted","Moringa: strong, simple, useful"],"sources":[{"label":"Muhammadiyah Plants 114 Moringa Trees in Palu","url":"https://muhammadiyah.or.id/2026/10/sambut-tanwir-dan-milad-ke-114-muhammadiyah-tanam-114-pohon-kelor-di-palu/"},{"label":"The Meaning Behind the Logo","url":"https://muhammadiyah.or.id/2026/09/makna-di-balik-logo-tanwir-dan-milad-ke-114-muhammadiyah/"}],"branch":"kanopi","verified":true},{"id":"buah-2027","year":"2026–2027","kicker":"Fruit","title":"Together, uniting the nation","paragraphs":["Tanwir and the 114th Milad take place in Palu on 13–15 November 2026; the historic Milad is commemorated on 18 November 2026. The theme “Bersama Satukan Bangsa” calls for togetherness directed toward justice, prosperity, welfare, morality, knowledge, and technology.","Tanwir prepares Muhammadiyah's programme for the next 25 years and serves as a forum for evaluation ahead of the 49th Muktamar in Medan in 2027."],"facts":["Tanwir & Milad: 13–15 November 2026","Milad: 18 November 2026","49th Muktamar: Medan, 2027"],"sources":[{"label":"Muhammadiyah's 25-Year Programme","url":"https://muhammadiyah.or.id/2026/09/tanwir-di-palu-akan-susun-program-muhammadiyah-untuk-25-tahun-mendatang/"},{"label":"Preparing for the 2027 Muktamar","url":"https://muhammadiyah.or.id/2026/09/tanwir-muhammadiyah-jadi-forum-evaluasi-dan-persiapan-muktamar-2027/"}],"branch":"kanopi","verified":true}]},"services":{"eyebrow":"Trunk","title":"Muhammadiyah Services","description":"Three services support the tree: the official KHGT calendar, the latest news from Muhammadiyah, and a quiz to test your knowledge.","calendarTitle":"Global Unified Hijri Calendar","calendarDescription":"Calendar data is synchronised from KHGT. Month views, special days, and the Gregorian–Hijri converter use an official snapshot, not a generic library.","highlightsTitle":"Milad Markers","highlightsLink":"Open KHGT","kabarTitle":"Official Muhammadiyah News","kabarDescription":"Pulled from Muhammadiyah's official channel, cached for one hour, with a snapshot fallback. Full articles remain at the original source.","quizTitle":"114th Milad Quiz","quizDescription":"Test your knowledge of history, the logo, Palu, and the Milad theme. Every answer includes an explanation and a source.","sourceTitle":"Source notes","sourceDescription":"The calendar comes from KHGT; news comes from Muhammadiyah's official channel. If official data cannot load, the page shows the latest snapshot and a link to the source."},"calendar":{"locale":"en-GB","hijriTab":"KHGT Hijri","masehiTab":"Gregorian","fullCalendar":"View the full calendar on KHGT","prev":"Previous month","next":"Next month","specialDays":"Special days","noSpecial":"No special days in this month.","converter":"Date converter","masehiLabel":"Gregorian date","masehiButton":"Find Hijri","hijriMonthLabel":"Hijri month","hijriDayLabel":"Day","hijriYearLabel":"Year","hijriButton":"Find Gregorian","placeholder":"Choose a date to see its Gregorian–Hijri equivalent.","notFound":"Date not found in the 2026 KHGT snapshot.","source":"Source","snapshot":"snapshot","disclaimer":"This calendar is not a replacement for the official KHGT calendar.","weekdays":["Sun","Mon","Tue","Wed","Thu","Fri","Sat"],"hijriMonths":{"Muharam":"Muharram","Safar":"Safar","Rabiulawal":"Rabi al-Awwal","Rabiulakhir":"Rabi al-Thani","Jumadilawal":"Jumada al-Awwal","Jumadilakhir":"Jumada al-Thani","Rajab":"Rajab","Syakban":"Sha'ban","Ramadan":"Ramadan","Syawal":"Shawwal","Zulkaidah":"Dhu al-Qi'dah","Zulhijah":"Dhu al-Hijjah"},"gregorianMonths":{"Januari":"January","Februari":"February","Maret":"March","April":"April","Mei":"May","Juni":"June","Juli":"July","Agustus":"August","September":"September","Oktober":"October","November":"November","Desember":"December"},"gregorianMonthList":["January","February","March","April","May","June","July","August","September","October","November","December"],"eventNames":{"Ayyamul Bidh":"Ayyamul Bidh","Hari Tasua":"Tasua","Hari Asyuro":"Ashura","Hari Tahun baru Islam (Hijriah)":"Islamic New Year","Hari Tahun Baru Islam (Hijriah)":"Islamic New Year"},"miladLabel":"Milad"},"kabar":{"eyebrow":"News","title":"News from Muhammadiyah","description":"The latest news from Muhammadiyah's official channel. Brief summaries, with links to the original source.","all":"View all news","source":"Source","sourceNote":"data refreshes automatically with a one-hour cache.","originalNote":"Titles and summaries come from the official source; the original text is in Indonesian.","empty":"Official news is currently unavailable. Open muhammadiyah.or.id directly.","read":"Read on muhammadiyah.or.id","tabs":{"latest":"Latest","milad":"Milad & Tanwir"}},"quiz":{"eyebrow":"Quiz","title":"114th Milad Quiz","description":"Test your knowledge of history, the logo, Palu, and the Milad theme. Every answer includes an explanation and a source.","startTitle":"How deep are your roots?","startDescription":"Ten questions on the history, logo, Palu, and theme of the 114th Milad. Every answer comes with an explanation and a source link. Your best score is stored on this device.","tags":["10 questions","Multiple choice","No backend"],"startButton":"Start the Quiz","best":"Your best","bestShort":"Best","questionOf":"Question {current} of {total}","correct":"Correct.","wrong":"Not quite. The correct answer is: {answer}.","source":"Source","next":"Next","seeResult":"See Result","choose":"Choose one answer to continue.","resultEyebrow":"Result","resultBest":"Best score","share":"Share score","shareText":"I scored {score}/100 in the 114th Muhammadiyah Milad Quiz. Want to try?","retry":"Try Again","readHistory":"Read the History","badges":[{"min":100,"title":"Complete Tree","description":"Every answer is correct. Root, trunk, and canopy in balance."},{"min":80,"title":"Strong Root","description":"Your knowledge runs deep. Almost perfect."},{"min":50,"title":"Sprout","description":"You are growing. Revisit the history chapters to strengthen your roots."},{"min":0,"title":"Time to Grow","description":"No problem. Start from the root: 1912 and Kauman."}],"questions":[{"id":1,"question":"When was Muhammadiyah founded?","options":["18 November 1911","18 November 1912","18 November 1913","18 November 1914"],"answerIndex":1,"explanation":"Muhammadiyah was founded on 18 November 1912 CE, or 8 Dhu al-Hijjah 1330 AH, in Kauman, Yogyakarta.","source":"A Brief History of Muhammadiyah","sourceUrl":"https://muhammadiyah.or.id/sejarah-singkat-muhammadiyah/"},{"id":2,"question":"Who founded Muhammadiyah?","options":["KH Ahmad Dahlan","KH Ibrahim","KH Mas Mansur","Ki Bagus Hadikusuma"],"answerIndex":0,"explanation":"KH Ahmad Dahlan, whose childhood name was Muhammad Darwis, founded Muhammadiyah.","source":"The Founding of Muhammadiyah","sourceUrl":"https://muhammadiyah.or.id/sejarah-berdirinya-muhammadiyah/"},{"id":3,"question":"Where was Muhammadiyah founded?","options":["Kauman, Yogyakarta","Palu, Central Sulawesi","Medan, North Sumatra","Bandung, West Java"],"answerIndex":0,"explanation":"Muhammadiyah was founded in Kauman, Yogyakarta.","source":"A Brief History of Muhammadiyah","sourceUrl":"https://muhammadiyah.or.id/sejarah-singkat-muhammadiyah/"},{"id":4,"question":"Which school was started before Muhammadiyah was founded?","options":["Madrasah Ibtidaiyah Diniyah Islamiyah","Kweekschool Jetis","STOVIA","Al-Azhar"],"answerIndex":0,"explanation":"Madrasah Ibtidaiyah Diniyah Islamiyah was inaugurated on 1 December 1911, before the organisation was founded.","source":"The Founding of Muhammadiyah","sourceUrl":"https://muhammadiyah.or.id/sejarah-berdirinya-muhammadiyah/"},{"id":5,"question":"When is Tanwir and the 114th Milad in Palu?","options":["13–15 November 2026","20–22 November 2026","18–20 November 2026","13–15 December 2026"],"answerIndex":0,"explanation":"Tanwir and the 114th Milad take place in Palu on 13–15 November 2026, corresponding to 4–6 Jumada al Thani 1448 AH.","source":"Official logo + KHGT","sourceUrl":"https://khgt.muhammadiyah.or.id/"},{"id":6,"question":"What is the theme of the 114th Milad?","options":["Bersama Satukan Bangsa","Cahaya Islam Berkemajuan","Islam Berkemajuan","Satu Nusa Satu Bangsa"],"answerIndex":0,"explanation":"The official theme is “Bersama Satukan Bangsa” (Together, Unite the Nation).","source":"Official Tanwir and Milad 114 logo","sourceUrl":"https://muhammadiyah.or.id/2026/09/semangat-menyatukan-bangsa-terpancar-dari-logo-milad-ke-114-muhammadiyah/"},{"id":7,"question":"What is the main element of the 114th Milad logo?","options":["Moringa leaves and the number 114","Rice and cotton","Waves and a boat","Mountains and stars"],"answerIndex":0,"explanation":"The logo combines moringa leaves with the number 114; the Muhammadiyah emblem sits at its peak.","source":"The Meaning Behind the Logo","sourceUrl":"https://muhammadiyah.or.id/2026/09/makna-di-balik-logo-tanwir-dan-milad-ke-114-muhammadiyah/"},{"id":8,"question":"How many moringa trees were planted in Palu?","options":["14","44","114","1,140"],"answerIndex":2,"explanation":"The committee planted 114 moringa trees in Palu as part of the Milad programme.","source":"Muhammadiyah Plants 114 Moringa Trees in Palu","sourceUrl":"https://muhammadiyah.or.id/2026/10/sambut-tanwir-dan-milad-ke-114-muhammadiyah-tanam-114-pohon-kelor-di-palu/"},{"id":9,"question":"13–15 November 2026 corresponds to which Hijri date?","options":["4–6 Jumada al-Thani 1448 AH","10–12 Jumada al-Thani 1448 AH","4–6 Dhu al-Hijjah 1448 AH","4–6 Rabi al-Thani 1448 AH"],"answerIndex":0,"explanation":"KHGT records 13–15 November 2026 as 4–6 Jumada al-Thani 1448 AH.","source":"Global Unified Hijri Calendar","sourceUrl":"https://khgt.muhammadiyah.or.id/"},{"id":10,"question":"Which Al-Hujurat verses are linked to the theme?","options":["10 and 13","1 and 2","11 and 12","3 and 4"],"answerIndex":0,"explanation":"The theme “Bersama Satukan Bangsa” is linked to Quran 49:10 and 49:13.","source":"The Meaning Behind the Logo","sourceUrl":"https://muhammadiyah.or.id/2026/09/makna-di-balik-logo-tanwir-dan-milad-ke-114-muhammadiyah/"}]},"map":{"eyebrow":"Canopy","title":"Muhammadiyah Around the World","description":"Muhammadiyah did not grow only in Indonesia. 29 Special Branch Leaderships are spread across Africa, Asia, Europe, the Americas, and Oceania.","count":"29 Special Branch Leaderships","note":"The world map uses Natural Earth data. Dots mark PCIM hub cities; country borders are for orientation only.","source":"Source","aria":"World map highlighting the 29 countries of Muhammadiyah PCIM.","countryList":"PCIM countries","cityLabel":"City","regions":{"africa":"Africa","asia":"Asia","europe":"Europe","americas":"Americas","oceania":"Oceania"}},"footer":{"tagline":"One tree, three directions: History, Services, and Map. Built as an independent entry for a website competition.","explore":"Explore","sources":"Official sources","event":"114th Milad","eventLines":["Palu, Central Sulawesi","13–15 November 2026","4–6 Jumada al-Thani 1448 AH"],"credit":"Logo and visual identity belong to PP Muhammadiyah. El Messiri and Familjen Grotesk are licensed under the OFL.","copyright":"© 2026 Milad 114 — an independent website competition entry.","dataNote":"Calendar data: KHGT. News data: muhammadiyah.or.id. Verified again before publication.","language":"Language"},"notFound":{"title":"This door is not on the tree yet.","description":"Return home, explore the 114-year trail, or open Muhammadiyah services.","home":"Back to the Milad","history":"114-Year Trail","services":"Services"},"highlights":[{"date":"2026-11-13","title":"Tanwir and the 114th Milad","note":"Palu, 13–15 November 2026 · 4–6 Jumada al-Thani 1448 AH","source":"Official logo + KHGT","sourceUrl":"https://khgt.muhammadiyah.or.id/"},{"date":"2026-11-18","title":"114th Muhammadiyah Milad","note":"Historic Milad · 9 Jumada al-Thani 1448 AH","source":"Official logo + KHGT","sourceUrl":"https://khgt.muhammadiyah.or.id/"},{"date":"2026-06-16","title":"1 Muharram 1448","note":"Islamic New Year","source":"KHGT","sourceUrl":"https://khgt.muhammadiyah.or.id/"},{"date":"2026-06-24","title":"9 Muharram 1448","note":"Tasua","source":"KHGT","sourceUrl":"https://khgt.muhammadiyah.or.id/"},{"date":"2026-06-25","title":"10 Muharram 1448","note":"Ashura","source":"KHGT","sourceUrl":"https://khgt.muhammadiyah.or.id/"}]}}],"$L1f","$L20","$L21","$L22"]}]
